{
  "mediaSources": [
    {
      "factoryId": "json-api",
      "version": 1,
      "arguments": {
        "name": "稀饭动漫 Next",
        "websiteUrl": "https://next.xifanacg.com",
        "iconUrl": "https://next.xifanacg.com/favicon.ico",
        "headers": {
          "apikey": "sb_publishable_OBIVAWACIX6lPXrO98_z24_HcsmalkA",
          "Authorization": "Bearer sb_publishable_OBIVAWACIX6lPXrO98_z24_HcsmalkA",
          "Origin": "https://next.xifanacg.com"
        },
        "search": {
          "request": {
            "url": "https://api.xifanacg.com/rest/v1/rpc/search_animes",
            "method": "POST",
            "body": {
              "search_term": "{keyword}",
              "page_number": "{page}",
              "items_per_page": "{pageSize}",
              "sort_by": "bangumi_score",
              "sort_order": "desc",
              "filter_only_published": true
            }
          },
          "itemsPath": "$[*]",
          "idPath": "$.id",
          "namePath": "$.title",
          "aliasesPath": "$['title_original','aliases']",
          "subjectUrl": "https://next.xifanacg.com/anime/{subjectId}",
          "paginate": true,
          "pageSize": 50
        },
        "detail": {
          "request": {
            "url": "https://api.xifanacg.com/rest/v1/rpc/get_anime_detail",
            "method": "POST",
            "body": {"p_id": "{subjectId}"}
          },
          "channelsPath": "$.sources[*]",
          "channelIdPath": "$.code",
          "channelNamePath": "$.name",
          "episodesPath": "$.episodes[*]",
          "episodeIdPath": "$.id",
          "episodeNamePath": "$.title",
          "episodeNumberPath": "$.episode_number",
          "episodeKindPath": "$.kind",
          "episodeKindPrefixes": {
            "main": "", "special": "SP", "sp": "SP", "ova": "OVA",
            "oad": "OAD", "op": "OP", "ed": "ED", "pv": "PV"
          },
          "episodeUrl": "https://next.xifanacg.com/anime/{subjectId}/play/{episodeId}?source={channelId}"
        },
        "playback": {
          "request": {
            "url": "https://api.xifanacg.com/functions/v1/issue-web-playback",
            "method": "POST",
            "body": {"action": "fallback", "episode_id": "{episodeId}", "source": "{channelId}"}
          },
          "successPath": "$.ok",
          "urlPath": "$.url",
          "candidatesPath": "$.candidates[*]",
          "candidateIdPath": "$.source_code",
          "candidateUrlPath": "$.url"
        },
        "tier": 0,
        "channelTiers": {"稀饭新番主线-2": 0, "稀饭旧番主线-1": 1}
      }
    }
  ]
}
