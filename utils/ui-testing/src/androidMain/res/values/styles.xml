<resources>
    <!--
      TV 界面 instrumented test 的 Activity 主题, 与 TvDisplayRunListener 配合使用.
      电视没有系统栏, 而测试设备 (手机模拟器) 有导航栏; 窗口延伸到系统栏之下,
      Compose 根节点才是完整的 960×540dp, 测试按电视规格断言的布局才能成立.
    -->
    <style name="AniTvDeviceTest" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
