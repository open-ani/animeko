<!-- Leanback 启动器横幅 (320x180). 视觉复刻 PR#3217: #2F3943 底 + #7EBBED 圆环 + 白圆.
     TODO(M4): 补齐 PR 视觉中的黑「あ」字形 (需矢量路径), 参照 claude.ai/design「Animeko TV」镜像. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2F3943" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                    android:width="100dp"
                    android:height="100dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                    android:width="10dp"
                    android:color="#7EBBED" />
        </shape>
    </item>
</layer-list>
