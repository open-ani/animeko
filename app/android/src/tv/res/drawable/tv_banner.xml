<!--
  Android TV 主屏横幅 (banner). 必须是 16:9, 这里用 320x180 的固定 viewport 保证
  启动器等比缩放、不会被拉伸变形.
  Logo 复用 ic_launcher_foreground 的 "あ" 路径及其居中变换 (内层 group), 外层 group
  以圆心 (160,90) 为中心整体放大, 使其在白色圆内有合适的占比.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="320dp"
        android:height="180dp"
        android:viewportWidth="320"
        android:viewportHeight="180">

    <!-- 背景 -->
    <path
            android:fillColor="#2F3943"
            android:pathData="M0,0h320v180h-320z" />

    <!-- 外圈蓝色实心圆 (半径 60) -->
    <path
            android:fillColor="#7EBBED"
            android:pathData="M160,90 m-60,0 a60,60 0 1,0 120,0 a60,60 0 1,0 -120,0" />

    <!-- 内部白色实心圆 (半径 48, 形成 12 的蓝色圆环) -->
    <path
            android:fillColor="#FFFFFF"
            android:pathData="M160,90 m-48,0 a48,48 0 1,0 96,0 a48,48 0 1,0 -96,0" />

    <!-- Logo: 外层以 (54,54) 为轴放大并平移到圆心, 内层为 foreground 原始居中变换 -->
    <group
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="2.7"
            android:scaleY="2.7"
            android:translateX="106"
            android:translateY="36">
